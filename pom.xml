<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>dhapp</artifactId>
    <version>1.0.0</version>
    <!-- WildFly へデプロイするため war パッケージング -->
    <packaging>war</packaging>
    <name>dhapp</name>
    <description>Spring Boot WAR on WildFly with JTA/XA 2PC across DHCOMAP and DHINFAP</description>

    <properties>
        <!-- OpenJDK 21 -->
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <aws.sdk.version>2.54.18</aws.sdk.version>
        <!--
            Spring Boot 3.3.5 の BOM は Log4j2 2.23.1。tracelog の時間ローテーションで
            Stale file handle を観測するため、バインディングを 2.25.3 に固定する。
        -->
        <log4j2.version>2.25.3</log4j2.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Spring MVC (REST)。ログ実装は Logback ではなく下の Log4j2 を使う。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!--
            SLF4J 2 を Log4j2 へ渡す。war に入るのは次の 3 つ（バージョンは log4j2.version）。
              log4j-api-2.25.3.jar
              log4j-core-2.25.3.jar
              log4j-slf4j2-impl-2.25.3.jar
            log4j-to-slf4j（Log4j API → SLF4J）は starter-logging 側にあり、
            log4j-slf4j2-impl と同時に置くとルーティングが循環するため入れない。
        -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
        </dependency>

        <!--
            WAR デプロイ時は WildFly(Undertow) のサーブレットコンテナを使うため、
            組み込み Tomcat は provided にして war に含めない。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-tomcat</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- JdbcTemplate（DataSource は WildFly の JNDI から取得） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- ElastiCache for Valkey (Redis 互換) 用 Spring Data Redis + Lettuce -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Bean Validation (jakarta.validation) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!--
            PDF 生成ライブラリ（Apache PDFBox）。純 Java 実装で外部フォント不要
            （標準 14 フォントを使用）。date-config / secure-api / tls の呼び出し時に
            DATA_OUTPUT_DIR 配下へ "DUMMY" と記載した本物の PDF（dummy.pdf）を生成するために使用する。
            PDFBox 3.x はロギングに SLF4J を使う。アプリのバインディングは Log4j2。
        -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.3</version>
        </dependency>

        <!--
            Amazon SQS。POST /api/sqs/enqueue が app.sqs.queue-url のキューへ
            半角スペース 1 文字を SendMessage する。
            HTTP クライアントは JDK の HttpURLConnection（url-connection-client）。
            Netty 製クライアントは WildFly 上のクラスロードと衝突しやすいため使わない。
        -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sqs</artifactId>
            <exclusions>
                <!-- サービス側で UrlConnectionHttpClient を明示する。既定の Netty / Apache クライアントは war に入れない。 -->
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>netty-nio-client</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>apache5-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
        </dependency>

        <!--
            JTA API (jakarta.transaction)。WildFly が実装を提供するため provided。
            JtaTransactionManager / UserTransaction はランタイムにコンテナのものを使う。
        -->
        <dependency>
            <groupId>jakarta.transaction</groupId>
            <artifactId>jakarta.transaction-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
            MySQL Connector/J はアプリの war には含めない。
            WildFly のモジュール（com.mysql）として登録し、XA データソースを
            WildFly 側で構成する（wildfly/register-mysql-driver.cli）。
            MySQL 8.4.7 に対しては Connector/J 9.7.0 を使用する。

            注意: Connector/J 9.5.0 以降は XAResource.isSameRM() がスキーマ名を
            比較しなくなった（Bug #18403804）。DHCOMAP と DHINFAP が同一 MySQL
            インスタンス上にある場合、XA データソースに same-rm-override=false を
            設定しないと 2PC が XAER_INVAL / IJ000457 で失敗する。README.md 参照。
        -->

        <!-- テスト -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <!-- 生成される war 名を dhapp.war に固定 → コンテキストパスは /dhapp -->
        <finalName>dhapp</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
